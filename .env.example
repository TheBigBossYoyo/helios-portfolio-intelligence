# Every HELIOS_* setting the backend reads is listed here, with its default, so nothing is
# configurable-but-undiscoverable. Blank means "unset" -- Helios treats an empty credential as
# absent rather than as an empty string.
#
# The three below are the exception: they are read by Docker Compose and the web app, NOT by
# the Python settings object, so they have no equivalent in src/helios/config.py.

# Compose host bindings (loopback only)
HELIOS_API_PORT=8001
HELIOS_WEB_PORT=3001
# Read server-side only. The browser never sees this value; the dashboard fetches in RSCs.
HELIOS_API_URL=http://127.0.0.1:8001

# Helios backend defaults
HELIOS_APP_NAME=helios
HELIOS_LOG_LEVEL=INFO
# Only EUR is supported; anything else is rejected at startup rather than silently mis-valued.
HELIOS_BASE_CURRENCY=EUR
# Where the API process itself binds inside its container. Compose maps the published port.
HELIOS_BIND_HOST=127.0.0.1
HELIOS_BIND_PORT=8000
# SQLite lives here. Compose overrides HELIOS_DATA_DIR to /app/data and mounts ./data onto it.
HELIOS_DATA_DIR=data
HELIOS_SQLITE_FILENAME=helios.sqlite3
HELIOS_T212_BASE_URL=https://demo.trading212.com/api/v0
HELIOS_T212_API_KEY=
HELIOS_T212_API_SECRET=
HELIOS_T212_TIMEOUT_SECONDS=10
HELIOS_T212_MAX_RETRIES=3
HELIOS_INSTRUMENT_METADATA_TTL_HOURS=24
HELIOS_RECONCILIATION_TOLERANCE=0.001
HELIOS_INSTRUMENT_OVERRIDES_PATH=config/instrument_overrides.yaml
HELIOS_OPENFIGI_BASE_URL=https://api.openfigi.com/v3
HELIOS_OPENFIGI_API_KEY=
HELIOS_RESOLVER_TIMEOUT_SECONDS=10
# After every successful sync, also replay history and refresh news automatically.
HELIOS_REFRESH_AFTER_SYNC=true
# Restart automatically a few seconds after a settings change saved from the dashboard.
HELIOS_AUTO_APPLY_SETTINGS=true
# Card history: request Trading 212's CSV export (the only source that labels card payments,
# merchants and cashback) at most once per cadence. Each export notifies the Trading 212 app.
HELIOS_CARD_HISTORY_ENABLED=true
HELIOS_CARD_EXPORT_CADENCE_HOURS=24
HELIOS_CARD_HISTORY_POLL_MINUTES=15
HELIOS_SYNC_CADENCE_MINUTES=60
HELIOS_SYNC_LEASE_MINUTES=15

# Analytics (Milestone 3)
HELIOS_ANALYTICS_FLOW_TIMING=flow_at_close
HELIOS_ANALYTICS_MAX_PRICE_STALE_DAYS=10
HELIOS_ANALYTICS_MAX_FX_STALE_DAYS=10
HELIOS_ANALYTICS_PASSIVE_BENCHMARK_KEY=vwrp
# Correlation clustering: distance cutoff, and the aligned observations a holding needs before
# it is clustered at all rather than reported as insufficient_data.
HELIOS_ANALYTICS_CLUSTER_DISTANCE_THRESHOLD=1.0
HELIOS_ANALYTICS_MIN_CLUSTER_OBSERVATIONS=20
# Subtracted from returns before Sharpe/Sortino and the factor regression. Left at zero because
# guessing a rate would quietly change every risk-adjusted figure.
HELIOS_ANALYTICS_RISK_FREE_RATE=0
# ECB publishes the EUR reference rates Helios converts every non-EUR flow at. No account.
HELIOS_ECB_BASE_URL=https://data-api.ecb.europa.eu/service/data
# Prices: 'twelvedata' (free tier, 800 calls/day) | 'alphavantage' | 'disabled'.
# ACCOUNT NEEDED for either. Free key: https://twelvedata.com/pricing
# Without one, all price-dependent analytics report "unavailable" and nothing is fabricated.
HELIOS_MARKET_DATA_PROVIDER=twelvedata
HELIOS_MARKET_DATA_API_KEY=
HELIOS_MARKET_DATA_TIMEOUT_SECONDS=15
# Endpoint per provider. MARKET_DATA_BASE_URL is Alpha Vantage's; Twelve Data has its own.
HELIOS_MARKET_DATA_BASE_URL=https://www.alphavantage.co/query
HELIOS_TWELVEDATA_BASE_URL=https://api.twelvedata.com/time_series
# Exchanges your Twelve Data plan covers. Free = US only; London symbols then go
# straight to the fallback provider. A paid plan reaching London: US,LSE
HELIOS_TWELVEDATA_EXCHANGES=US
# Spacing between requests, in seconds: free plans are metered per minute and per day.
HELIOS_TWELVEDATA_MIN_INTERVAL_SECONDS=7.6
HELIOS_ALPHAVANTAGE_MIN_INTERVAL_SECONDS=12.5
# Optional second market-data account, asked only for symbols the primary provider could not
# price (e.g. Twelve Data's free plan is US-only; Alpha Vantage's free key -- 25 requests/day --
# covers non-US listings like London via its own TSCO.LON-style symbols). Recommended pairing
# for a portfolio with both US and LSE holdings: HELIOS_MARKET_DATA_PROVIDER=twelvedata +
# HELIOS_MARKET_DATA_FALLBACK_PROVIDER=alphavantage. 'disabled' (default) | 'twelvedata' |
# 'alphavantage'. ACCOUNT NEEDED when set to either provider: https://www.alphavantage.co/support/#api-key
HELIOS_MARKET_DATA_FALLBACK_PROVIDER=disabled
HELIOS_MARKET_DATA_FALLBACK_API_KEY=
# Factors: 'kenfrench' (free, official, NO ACCOUNT) | 'disabled'.
# Published monthly and trails the present by ~1 month, so the regression covers only the
# overlap with your NAV history.
HELIOS_FACTOR_DATA_PROVIDER=kenfrench
HELIOS_KEN_FRENCH_FIVE_FACTOR_URL=https://mba.tuck.dartmouth.edu/pages/faculty/ken.french/ftp/F-F_Research_Data_5_Factors_2x3_daily_CSV.zip
HELIOS_KEN_FRENCH_MOMENTUM_URL=https://mba.tuck.dartmouth.edu/pages/faculty/ken.french/ftp/F-F_Momentum_Factor_daily_CSV.zip
# Benchmark proxies default to US listings (IVV/URTH/VT) because the free price tier covers US
# exchanges only. They track the same indices as the UCITS ETFs an EU investor would buy, but
# differ in dividend withholding -- so treat the passive comparison as an approximation.
# With a provider covering the LSE, switch to CSPX.LON / SWDA.LON / VWRP.LON.
HELIOS_BENCHMARK_CSPX_SYMBOL=IVV
HELIOS_BENCHMARK_SWDA_SYMBOL=URTH
HELIOS_BENCHMARK_VWRP_SYMBOL=VT
HELIOS_BENCHMARK_CSPX_CURRENCY=USD
HELIOS_BENCHMARK_SWDA_CURRENCY=USD
HELIOS_BENCHMARK_VWRP_CURRENCY=USD
# Brinson-Fachler sector attribution: benchmark sector weights and sector-return proxies, filled
# in by hand (see the file's own header). Ships empty, so the Attribution panel reports
# "unavailable" until you declare an entry for HELIOS_ANALYTICS_PASSIVE_BENCHMARK_KEY.
HELIOS_BENCHMARK_SECTORS_PATH=config/benchmark_sectors.yaml

# News (Milestone 5) — which sources run is set in config/news_feeds.yaml. Sources needing no
# credential ship enabled; anything needing one ships disabled.
HELIOS_NEWS_FEEDS_PATH=config/news_feeds.yaml
HELIOS_NEWS_SYNC_CADENCE_MINUTES=180
HELIOS_NEWS_DEDUPE_WINDOW_HOURS=48
HELIOS_NEWS_TIMEOUT_SECONDS=15
# Per-feed item cap and a hard body-size ceiling, so one oversized response cannot exhaust memory.
HELIOS_NEWS_MAX_ITEMS_PER_FEED=100
HELIOS_NEWS_MAX_BODY_BYTES=5000000
# Sent to every feed except SEC, which needs the contact agent below instead.
HELIOS_NEWS_USER_AGENT=helios-local/0.1 (personal read-only portfolio tracker)
# ACCOUNT NEEDED for the Marketaux source only. Free signup at https://www.marketaux.com
HELIOS_NEWS_MARKETAUX_BASE_URL=https://api.marketaux.com/v1
HELIOS_NEWS_MARKETAUX_API_KEY=
# The SEC requires a User-Agent naming a real contact. The sec-edgar feed is enabled but stays
# SKIPPED until this is set -- it is read from here so your address never enters the repo.
# Format: "Your Name your@email.com"
HELIOS_NEWS_SEC_USER_AGENT=

# AI analysis (Milestone 6) — ACCOUNT NEEDED: https://console.anthropic.com
# Leave the key empty and Helios runs fine; the Insights page just reports "unavailable".
HELIOS_ANTHROPIC_API_KEY=
HELIOS_ANTHROPIC_MODEL=claude-opus-5
HELIOS_ANTHROPIC_EFFORT=high
HELIOS_ANTHROPIC_MAX_TOKENS=8000
HELIOS_ANTHROPIC_TIMEOUT_SECONDS=120
# Opus 5's safety classifiers can decline a request. When they do, Anthropic re-runs it on this
# model server-side rather than returning the refusal.
HELIOS_ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8
# Headlines included in the analysis prompt. Higher costs more per run.
HELIOS_AI_MAX_NEWS_ITEMS=40

# Keyring alternative: keep HELIOS_T212_API_SECRET empty and store the secret in your OS keyring.
HELIOS_T212_KEYRING_SERVICE=helios.t212
HELIOS_T212_KEYRING_USERNAME=

# Dashboard settings page. Both are set by compose.yaml for the Docker deployment and are only
# worth touching when running Helios bare. Writes are allowed unless this is false; under Compose
# it is false because a change saved from the page could never be read there.
# HELIOS_SETTINGS_WRITABLE=true
# Comma-separated hosts besides loopback allowed to reach the settings routes. Compose sets `web`.
# HELIOS_SETTINGS_TRUSTED_PEERS=
# How the Restart button bounces the API: re-exec in place (default), or `exit` so a supervisor
# (systemd, a container restart policy) starts a clean process.
# HELIOS_RESTART_MODE=
# Which dotenv file Helios reads, and the settings page writes. Defaults to ./.env in the
# directory Helios starts in; the desktop launcher pins it to the checkout's .env.
# HELIOS_ENV_FILE=
# Desktop app only: the Helios checkout (normally found automatically), and where the built
# dashboard, the app window's browser profile and the logs live (default %LOCALAPPDATA%\Helios).
# HELIOS_HOME=
# HELIOS_DESKTOP_HOME=
